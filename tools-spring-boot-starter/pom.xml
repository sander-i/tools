<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.sander-i</groupId>
        <artifactId>tools</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <groupId>io.github.sander-i.spring.boot</groupId>
    <artifactId>tools-spring-boot-starter</artifactId>

    <packaging>pom</packaging>

    <name>${project.artifactId}</name>

    <description>Spring Boot integration for tools, providing auto-configuration
        for the tools modules.
        Copyright © ${project.inceptionYear}-${build.year} sander
    </description>

    <url>https://github.com/sander-i/tools/tree/release/tools-spring-boot-starter</url>

    <properties>
        <spring.application.name>tools-spring-boot-starter</spring.application.name>
    </properties>

    <modules>
        <module>encrypt-spring-boot-starter</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.sander-i</groupId>
                <artifactId>bedrock</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.sander-i</groupId>
                <artifactId>encrypt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.sander-i.spring.boot</groupId>
                <artifactId>encrypt-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
