<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.tools</groupId>
        <artifactId>tools</artifactId>
        <version>1.0.3</version>
    </parent>

    <artifactId>tools-dependencies</artifactId>
    <packaging>pom</packaging>

    <properties>
        <tools.version>1.0.3</tools.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- https://mvnrepository.com/artifact/org.tools/bedrock -->
            <dependency>
                <groupId>org.tools</groupId>
                <artifactId>bedrock</artifactId>
                <version>${tools.version}</version>
                <scope>import</scope>
            </dependency>
            <!-- https://mvnrepository.com/artifact/org.tools/encrypt -->
            <dependency>
                <groupId>org.tools</groupId>
                <artifactId>encrypt</artifactId>
                <version>${tools.version}</version>
                <scope>import</scope>
            </dependency>
            <!-- https://mvnrepository.com/artifact/org.tools/fortify -->
            <dependency>
                <groupId>org.tools</groupId>
                <artifactId>fortify</artifactId>
                <version>${tools.version}</version>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>ailuoli</id>
            <url>http://ailuoli.com.cn:17993/repository/maven-public/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>aliyun-plugin</id>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>ailuoli-plugin</id>
            <url>http://ailuoli.com.cn:17993/repository/maven-public/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <profiles>
        <profile>
            <id>dev</id>
            <properties>
                <repository-id>ailuoli-dev-releases</repository-id>
                <repository-url>http://ailuoli.com.cn:17993/repository/ailuoli-dev-releases/</repository-url>
                <snapshot-id>ailuoli-dev-snapshots</snapshot-id>
                <snapshot-url>http://ailuoli.com.cn:17993/repository/ailuoli-dev-snapshots/</snapshot-url>
            </properties>
        </profile>
        <profile>
            <id>sit</id>
            <properties>
                <repository-id>ailuoli-sit-releases</repository-id>
                <repository-url>http://ailuoli.com.cn:17993/repository/ailuoli-sit-releases/</repository-url>
                <snapshot-id>ailuoli-sit-snapshots</snapshot-id>
                <snapshot-url>http://ailuoli.com.cn:17993/repository/ailuoli-sit-snapshots/</snapshot-url>
            </properties>
        </profile>
        <profile>
            <id>uat</id>
            <properties>
                <repository-id>ailuoli-uat-releases</repository-id>
                <repository-url>http://ailuoli.com.cn:17993/repository/ailuoli-uat-releases/</repository-url>
                <snapshot-id>ailuoli-uat-snapshots</snapshot-id>
                <snapshot-url>http://ailuoli.com.cn:17993/repository/ailuoli-uat-snapshots/</snapshot-url>
            </properties>
        </profile>
        <profile>
            <id>pre</id>
            <properties>
                <repository-id>ailuoli-pre-releases</repository-id>
                <repository-url>http://ailuoli.com.cn:17993/repository/ailuoli-pre-releases/</repository-url>
                <snapshot-id>ailuoli-pre-snapshots</snapshot-id>
                <snapshot-url>http://ailuoli.com.cn:17993/repository/ailuoli-pre-snapshots/</snapshot-url>
            </properties>
        </profile>
        <profile>
            <id>pro</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <repository-id>ailuoli-releases</repository-id>
                <repository-url>http://ailuoli.com.cn:17993/repository/ailuoli-releases/</repository-url>
                <snapshot-id>ailuoli-snapshots</snapshot-id>
                <snapshot-url>http://ailuoli.com.cn:17993/repository/ailuoli-snapshots/</snapshot-url>
            </properties>
        </profile>
    </profiles>

    <distributionManagement>
        <repository>
            <id>${repository-id}</id>
            <url>${repository-url}</url>
        </repository>
        <snapshotRepository>
            <id>${snapshot-id}</id>
            <url>${snapshot-url}</url>
        </snapshotRepository>
    </distributionManagement>

</project>
